<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.CodrinGreenReception" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/app_bg</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="colorPrimary">@color/notificationBarColor</item>
        <item name="colorPrimaryDark">@color/secondaryColor</item>
    </style>
    <style name="Theme.MaterialComponents.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.MaterialComponents.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.MaterialComponents.NoActionBar.Bridge">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="TextHint">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
    </style>
    <style name="error_dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:minWidth">300dp</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSoftInputMode">adjustUnspecified|stateVisible|adjustResize</item>
    </style>
    <style name="DialogTheme">
        <item name="windowFixedWidthMajor">70%</item>
        <item name="windowFixedWidthMinor">70%</item>
    </style>
    <style name="style_TitleText_editText" parent="android:Widget.TextView">
        <item name="android:textColor">@color/color_editTextTitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:paddingTop">@dimen/padding_medium</item>
        <item name="android:paddingBottom">@dimen/padding_medium</item>
    </style>
    <style name="fab_3_rounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Style_EditText_withBorder" parent="android:Widget.TextView">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_xmedium1</item>
        <item name="android:padding">@dimen/padding_normal</item>
        <item name="android:background">@drawable/rectangle_border_black</item>
    </style>
    <style name="style_TitleText_editText1" parent="android:Widget.TextView">
        <item name="android:textColor">@color/color_editTextTitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:paddingTop">@dimen/padding_small</item>
        <item name="android:paddingBottom">@dimen/padding_small</item>
    </style>
</resources>